
{
  "name": "youtube",
  "displayName": "YouTube",
  "baseUrl": "https://www.youtube.com",
  "description": "YouTube video search",
  "operations": [
    {
      "name": "search",
      "request": {
        "method": "GET",
        "url": "https://www.youtube.com/results?search_query={q}&sp=EgIQAQ%253D%253D",
        "headers": {
          "accept": "text/html,application/xhtml+xml",
          "accept-language": "en-US,en;q=0.9",
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "q",
          "at": [
            "query:search_query"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.youtube.com/results?search_query={q}&sp=EgIQAQ%253D%253D"
      },
      "match": {
        "method": "GET",
        "host": "www.youtube.com",
        "path": "/results"
      },
      "response": {
        "format": "embedded",
        "contentType": "text/html; charset=utf-8",
        "extract": "contents.twoColumnSearchResultsRenderer.primaryContents.sectionListRenderer.contents[*].itemSectionRenderer.contents",
        "pick": [
          "id=videoRenderer.videoId",
          "title=videoRenderer.title.runs[0].text",
          "channel=videoRenderer.ownerText.runs[0].text",
          "views=videoRenderer.viewCountText.simpleText"
        ],
        "embedded": {
          "regex": "var ytInitialData = (\\{)"
        }
      },
      "params": [
        {
          "name": "q",
          "type": "string",
          "required": true,
          "example": "Nashik Kumbh Mela 2027"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false,
      "learnedAt": "2026-09-27T17:41:32.693Z",
      "description": "Search YouTube videos and extract ID, title, channel and view count"
    }
  ]
}
